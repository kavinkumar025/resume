{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/resume",
  "routes": [
    {
      "src": "/seo(?:/|[.]html)",
      "status": 308,
      "headers": { "Location": "/seo" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/seo",
      "dest": "/seo.html"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
